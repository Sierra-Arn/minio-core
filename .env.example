# ====================================================  
# MinIO Connection Settings:  
#   - MINIO_HOST: Host address where the MinIO server is reachable.  
#                 Use "127.0.0.1" for local Docker host access,
#                 or adjust for remote/cloud deployments.
# ====================================================  
MINIO_HOST="127.0.0.1"


# ====================================================
# Port Configuration:
#   - MINIO_INTERNAL_PORT: Internal port used within Docker network 
#                          for container-to-container communication
#   - MINIO_EXTERNAL_PORT: External port exposed to host machine for 
#                          direct MinIO access from outside Docker
#
# Note: 
# Port 9000 is used by Jupyter Notebook kernels, 
# so MINIO_EXTERNAL_PORT is set to 22222 to avoid conflicts.
# ====================================================
MINIO_INTERNAL_PORT=9000
MINIO_EXTERNAL_PORT=22222


# ====================================================  
# Docker Container Names:
#   - MINIO_SERVER_CONTAINER: MinIO server container name for
#                             the S3-compatible object storage service  
# ====================================================  
MINIO_SERVER_CONTAINER="minio-server"


# ====================================================  
# MinIO Root User Configuration  
# ====================================================  
MINIO_ROOT_USERNAME="minio_admin"
MINIO_ROOT_PASSWORD="5up3r-53cr37-p455w0rd"
MINIO_DATA_PATH="./minio-data"


# ====================================================
# MinIO Bucket Configuration
# ====================================================
MINIO_BUCKET_NAME="storage"
MINIO_TEMP_PREFIX="temp/"
MINIO_PERMANENT_PREFIX="permanent/"
MINIO_TEMP_EXPIRATION_DAYS=1